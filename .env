# ============================================================
# ATS Analyzer — Environment Variable Template
# Copy this file to .env and adjust values.
# NEVER commit .env to source control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME="ATS Analyzer"
ENVIRONMENT=production
DEBUG=false

# ── Security (CHANGE BOTH BEFORE FIRST RUN) ─────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
MCP_HTTP_SECRET=CHANGE_ME_MCP_secret_token

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Available locally-pulled models only. Options:
#   qwen2.5:7b | qwen2.5:14b | llama3.1:8b | mistral-nemo
OLLAMA_LLM_MODEL=qwen2.5:7b
# Embedding model — must be pulled in pull_models.sh
#   nomic-embed-text | bge-m3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////app/data/db/ats_analyzer.db
# For multi-user PostgreSQL mode (optional):
# DATABASE_URL=postgresql+asyncpg://ats_user:ats_pass@db:5432/ats_analyzer

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_HOST=http://chromadb:8000
CHROMA_AUTH_TOKEN=CHANGE_ME_chroma_token

# ── File Storage ─────────────────────────────────────────────
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
REPORTS_DIR=/app/data/reports
DB_DIR=/app/data/db
CHROMA_DIR=/app/data/chroma
LOGS_DIR=/app/data/logs
MAX_UPLOAD_SIZE_MB=20

# ── Auth ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SINGLE_USER_MODE=true

# ── Network Egress Guard ──────────────────────────────────────
# Set to true to block all non-local outbound connections
BLOCK_EXTERNAL_NETWORK=true
# Comma-separated list of allowed internal hosts
ALLOWED_HOSTS=localhost,127.0.0.1,ollama,chromadb,backend,mcp_server

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# NEVER set LOG_PII=true in production
LOG_PII=false

# ── Data Retention ───────────────────────────────────────────
DEFAULT_RETENTION_DAYS=90

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ── ATS Scoring Weights (must sum to 100) ────────────────────
ATS_WEIGHT_PARSEABILITY=20
ATS_WEIGHT_SECTION_STRUCTURE=10
ATS_WEIGHT_CONTACT_COMPLETENESS=5
ATS_WEIGHT_KEYWORD_COVERAGE=25
ATS_WEIGHT_EXPERIENCE_ALIGNMENT=15
ATS_WEIGHT_ACHIEVEMENT_QUALITY=10
ATS_WEIGHT_READABILITY=10
ATS_WEIGHT_LINKEDIN_CONSISTENCY=5
